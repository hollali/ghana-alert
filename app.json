{
  "expo": {
    "name": "GhanaAlert",
    "slug": "ghana-alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghanaalert",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourorg.ghanaalert"
    },
    "android": {
      "package": "com.yourorg.ghanaalert",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#14306B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#14306B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#14306B"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to show alerts relevant to your area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach photos to your reports."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
