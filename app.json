{
  "expo": {
    "name": "GhanaAlert",
    "slug": "ghana-alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghanaalert",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ghanaalert",
      "infoPlist": {
        "NSPrivacyTrackingUsageDescription": "This app does not track you.",
        "NSLocationWhenInUseUsageDescription": "Used to show alerts relevant to your area.",
        "NSLocationUsageDescription": "Used to show alerts relevant to your area."
      }
    },
    "android": {
      "package": "app.ghanaalert",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#14306B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#14306B"
      },
      "backgroundColor": "#14306B",
      "routing": "expo-router"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#14306B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#14306B"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to show alerts relevant to your area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach photos to your reports.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
