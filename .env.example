# Environment variables for GhanaAlert
# These are placeholder values - replace with actual values before release

# ==========================================
# Expo / Mobile App Configuration
# ==========================================

# Expo Router configuration
EXPO_PUBLIC_ENABLE_TYPED_ROUTES=true

# Feature flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# API Configuration
# Public: no secrets, safe to ship in the app bundle
# Mobile calls Neon Auth directly and your Express API with a Bearer JWT
EXPO_PUBLIC_NEON_AUTH_URL=https://<auth-host>/<db>/auth
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ==========================================
# Server / Backend Configuration
# ==========================================

# Database (never commit a real URL)
DATABASE_URL=postgresql://neondb_owner:<password>@<host>/neondb?sslmode=require

# Server Port
PORT=3000

# ==========================================
# Authentication (Neon Auth - email/password)
# ==========================================

# Neon Auth base URL (from Neon Console > Auth > Configuration)
# Enable Auth in the Console first: Console > Auth > Enable Auth
# Server-side only; keep identical to EXPO_PUBLIC_NEON_AUTH_URL
# NEON_AUTH_BASE_URL=https://<auth-host>/<db>/auth
# NEON_AUTH_JWKS_URL=https://<auth-host>/<db>/auth/.well-known/jwks.json

# ==========================================
# Feature Flags
# ==========================================

# Enable/disable features
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_LOCATION_SERVICE=true
EXPO_PUBLIC_ENABLE_REPORT_SUBMISSION=true

# ==========================================
# Performance & Analytics
# ==========================================

# Sentry DSN (when crash reporting is enabled)
# SENTRY_DSN=https://o425110.ingest.sentry.io/450897...

# ==========================================
# URLs & Endpoints
# ==========================================

# Backend API base URL (development)
# API_BASE_URL=http://localhost:3000

# Backend API base URL (production)
# API_BASE_URL=https://api.ghanaalert.app
