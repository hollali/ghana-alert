                                                            # Environment variables for GhanaAlert
# These are placeholder values - replace with actual values before release

# ==========================================
# Expo / Mobile App Configuration
# ==========================================

# Expo Router configuration
EXPO_PUBLIC_ENABLE_TYPED_ROUTES=true

# Feature flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# API Configuration (when backend is integrated)
# Uncomment and set when backend is ready:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# EXPO_PUBLIC_API_TIMEOUT=10000

# ==========================================
# Server / Backend Configuration
# ==========================================

# Database
DATABASE_URL=postgresql://neondb_owner:npg_41EapbRQoWci@ep-still-unit-za1g32u9.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Server Port
PORT=3000

# ==========================================
# Authentication (Clerk or custom)
# ==========================================

# Clerk Public Key (when auth is integrated)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ==========================================
# Feature Flags
# ==========================================

# Enable/disable features
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_LOCATION_SERVICE=true
EXPO_PUBLIC_ENABLE_REPORT_SUBMISSION=true

# ==========================================
# Performance & Analytics
